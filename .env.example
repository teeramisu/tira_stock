# 数据库（可选）。未设置时保存/历史记录 API 返回 503，回测与行情正常可用。
# 例：postgresql+asyncpg://用户:密码@localhost:5432/stock_backtest
DATABASE_URL=

# 可选：日志级别（如 DEBUG, INFO, WARNING）
# LOG_LEVEL=INFO

# 可选：当 Yahoo 限流时，用以下任一 Key 拉取美股（可多配，按顺序尝试）
# Alpha Vantage 申请 https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=
# Financial Modeling Prep 申请 https://site.financialmodelingprep.com/developer/docs/dashboard
# FMP_API_KEY=

# 大模型评分（ETF LLM 评分 / 股票推荐）
# 配置后优先使用 DeepSeek API，无需安装本地模型（transformers/torch）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 可选：自定义 API 地址和模型名
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
